# Copy to .env (`make up` does it for you) and change the passwords.
# .env is gitignored; never commit real secrets.

# --- Postgres (admin user: owns the schema, used by migrations and ingestion) ---
POSTGRES_DB=sec_analyst
POSTGRES_USER=sec_admin
POSTGRES_PASSWORD=change-me-admin
# Host port published on 127.0.0.1 only. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# --- Read-only login used by the agent's query_financials tool ---
AGENT_RO_USER=agent_ro
AGENT_RO_PASSWORD=change-me-readonly

# --- SEC EDGAR ---
# Required by the SEC for automated access: who you are and how to reach you.
# Example: SEC_USER_AGENT=Your Company you@example.com
SEC_USER_AGENT=
ANTHROPIC_API_KEY=
# --- Anthropic API (the agent's LLM) ---
# Create a key at https://console.anthropic.com (API Keys). Never commit it.
ANTHROPIC_API_KEY=
# Optional overrides. claude-sonnet-5-5 costs half as much per token.
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium

# --- Slack bot (Socket Mode). See docs/SLACK_SETUP.md ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
